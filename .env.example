# Read tokens from https://xitter.space/account/api
# These see incoming Equicoins. They cannot send refunds.
XITTER_TOKEN=
XITTER_NYSE_TOKEN=

# Write tokens for the same accounts, used only to return an unmatched payment.
XITTER_WRITE_TOKEN=
XITTER_NYSE_WRITE_TOKEN=

# Optional. HTTPS deploys publish /api/oauth/client and do not need a client id.
# Localhost needs a connected app whose redirect is http://localhost:5173/api/oauth/callback
XITTER_CLIENT_ID=
XITTER_REDIRECT_URI=

# Comma-separated screen names. Defaults to nasdaq, nyse, ember, and puppy.
LARP_ADMINS=
# Comma-separated screen names for moderators (admins also have moderator permissions).
LARP_MODERATORS=

# Runtime on Netlify. The build does not read these.
# SESSION_SECRET keeps logins. CRON_SECRET locks the public cron URL.
# POSTGRES_URL keeps the book across cold starts. APP_ORIGIN is the https site URL.
SESSION_SECRET=
CRON_SECRET=
POSTGRES_URL=
APP_ORIGIN=
